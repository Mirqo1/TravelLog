rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['isPremium', 'role', 'admin', 'plan']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'role', 'admin', 'plan']);
    }
    match /users/{uid}/backups/{backupId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && backupId == 'notebook'
        && request.resource.data.keys().hasOnly(['version', 'revision', 'savedAt', 'trips'])
        && request.resource.data.version == 1
        && request.resource.data.revision is string
        && request.resource.data.savedAt is string
        && request.resource.data.trips is list;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Owner-only synchronization remains available after Premium expires, so
    // users can restore/read/remove previously saved places. Entitlements are
    // issued through trusted custom claims; no client writes to those claims.
    match /users/{uid}/wishlist/{itemId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.id == itemId
        && request.resource.data.changedAt is int
        && request.resource.data.changedAt >= 0
        && request.resource.data.deleted is bool
        && ((request.resource.data.deleted == true
          && request.resource.data.keys().hasOnly(['id', 'changedAt', 'deleted']))
        || (request.resource.data.deleted == false
          && request.resource.data.keys().hasOnly(['id', 'changedAt', 'deleted', 'name', 'locationName', 'notes', 'countryCode', 'location'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
          && request.resource.data.locationName is string && request.resource.data.locationName.size() <= 300
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
          && request.resource.data.countryCode is string && request.resource.data.countryCode.size() <= 2
          && request.resource.data.location.keys().hasOnly(['latitude', 'longitude'])
          && request.resource.data.location.latitude is number
          && request.resource.data.location.longitude is number
          && request.resource.data.location.latitude >= -90 && request.resource.data.location.latitude <= 90
          && request.resource.data.location.longitude >= -180 && request.resource.data.location.longitude <= 180));
      // Delete is a synchronized tombstone, not a physical document deletion.
      allow delete: if false;
    }

    match /places/{placeId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
